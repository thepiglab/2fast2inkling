+
+
+# inkling-rt sm_120 enablement: Inkling's compact rel-bias decode/verify partials on SM12x run
+# through the Hopper Triton split-KV kernel, never the SM100 CuTe or FA4 SM90 (wgmma) kernels.
+
+
+
+def _inkrt_sm12x():
+    return torch.cuda.get_device_capability()[0] == 12
+
+
+def _inkrt_rel_bias_partials(
+    q,
+    k_cache,
+    v_cache,
+    page_table,
+    seqused_k,
+    rel_bias,
+    softmax_scale,
+    out,
+    *,
+    window_size_left,
+    verify,
+):
+    if _inkrt_sm12x():
+        from sglang.kernels.ops.inkling2.decode_attention_sm90 import decode_partials
+
+        return decode_partials(
+            q,
+            k_cache,
+            v_cache,
+            page_table,
+            seqused_k,
+            rel_bias,
+            softmax_scale,
+            window_size_left=window_size_left,
+        )
+    from sglang.kernels.ops.inkling2.attention import rel_bias_partials as _rel_bias_partials
+
+    return _rel_bias_partials(
+        q,
+        k_cache,
+        v_cache,
+        page_table,
+        seqused_k,
+        rel_bias,
+        softmax_scale,
+        out,
+        window_size_left=window_size_left,
+        verify=verify,
+    )
+
+
+def _inkrt_same_dtype_out(fn):
+    """SM120 FA4 accepts only out.dtype == q.dtype: run with a q-dtype output and upcast into the
+    caller's buffer (one BF16 rounding of the attention output that SM100 keeps in FP32)."""
+
+    def wrapped(*args, out=None, **kwargs):
+        q = kwargs["q"] if "q" in kwargs else args[0]
+        if out is None or out.dtype == q.dtype:
+            return fn(*args, out=out, **kwargs)
+        tmp = torch.empty(out.shape, dtype=q.dtype, device=out.device)
+        result = fn(*args, out=tmp, **kwargs)
+        out.copy_(tmp)
+
+        def swap(t):
+            if isinstance(t, torch.Tensor) and t.data_ptr() == tmp.data_ptr():
+                return out.view(t.shape)
+            return t
+
+        if isinstance(result, tuple):
+            return (swap(result[0]), *result[1:])
+        return swap(result)
+
+    return wrapped
